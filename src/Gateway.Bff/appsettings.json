{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "invoicing-route": {
        "ClusterId": "invoicing-cluster",
        "Order": 1,
        "RateLimiterPolicy": "BotRateLimiterPolicy",
        "Match": {
          "Path": "/api/invoices/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Set" }
        ]
      },
      "financial-route": {
        "ClusterId": "financial-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/financial/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Set" }
        ]
      },
      "ui-route": {
        "ClusterId": "ui-cluster",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "invoicing-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://cub_invoicing_api:8080"
          }
        }
      },
      "financial-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://cub_financial_api:8080"
          }
        }
      },
      "ui-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://cub_portal_ui:8080"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 10,
    "QueueLimit": 10
  }
}
